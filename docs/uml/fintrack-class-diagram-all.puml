BudgetController --> BudgetMapper
SavingController --> SavingService
SavingController --> SavingMapper
DebtController --> DebtService
DebtController --> WalletRepository
DebtController --> DebtMapper
DebtController --> PaymentMapper
AdminController --> AdminService
AdminController --> WalletRepository
AdminController --> DebtRepository
AdminController --> SavingRepository
AiController --> AiService

UserController ..> Account : reads principal

AuthService --> AccountRepository
AuthService --> InfoUserRepository
AuthService --> OtpRepository
AuthService --> JwtService
AuthService --> EmailService
AuthService ..> OtpGenerator
AuthService ..> HashUtil

JwtAuthenticationFilter --> JwtService
JwtAuthenticationFilter --> AccountRepository
SecurityConfig --> JwtAuthenticationFilter

WalletService --> WalletRepository
WalletService --> AccountRepository
TransactionService --> TransactionRepository
TransactionService --> WalletRepository
TransactionService --> CategoryRepository
CategoryService --> CategoryRepository
SubCategoryService --> SubCategoryRepository
SubCategoryService --> CategoryRepository
BudgetService --> BudgetRepository
BudgetService --> WalletRepository
BudgetService --> CategoryRepository
BudgetService --> TransactionRepository
SavingService --> SavingRepository
SavingService --> SavingTransactionRepository
SavingService --> WalletRepository
SavingService --> TransactionRepository
DebtService --> DebtRepository
DebtService --> DebtPaymentRepository
DebtService --> WalletRepository
DebtService --> TransactionRepository
DebtService --> CategoryRepository
DebtService --> AccountRepository
AdminService --> AccountRepository
